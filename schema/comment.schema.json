{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oif.md/schema/0.1/comment.schema.json",
  "title": "OIF comment file frontmatter",
  "type": "object",
  "required": ["type", "at", "by"],
  "properties": {
    "type": { "const": "comment" },
    "at": { "type": "string", "format": "date-time" },
    "by": { "type": "string", "minLength": 1 },
    "resource": {
      "type": "string",
      "pattern": "^oif:[a-z][a-z0-9]{1,15}/[0-9a-hjkmnp-tv-z]{6}/[0-9a-hjkmnp-tv-z]{6}$"
    },
    "in_reply_to": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{6}$" }
  },
  "additionalProperties": true
}
