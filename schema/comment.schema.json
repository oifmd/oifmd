{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oif.md/schema/0.1/comment.schema.json",
  "title": "OIF comment file frontmatter",
  "type": "object",
  "required": [
    "type",
    "at",
    "by"
  ],
  "properties": {
    "type": {
      "const": "comment"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "pattern": "^oif:[a-z][a-z0-9]{1,15}/[0-9a-hjkmnp-tv-z]{6}(?:/[0-9a-hjkmnp-tv-z]{6})?$"
    },
    "about": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "kind": {
      "type": "string",
      "examples": [
        "confirms",
        "disputes",
        "caution",
        "note"
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "target": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "path": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "anchor": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "resource"
          ]
        }
      ],
      "additionalProperties": true
    }
  }
}
